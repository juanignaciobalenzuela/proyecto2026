{
  "compilerOptions": {
    // Node 24 ejecuta los .ts directamente borrando los tipos, sin compilar.
    // Por eso acá no se emite nada: TypeScript solo chequea.
    "noEmit": true,

    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Node borra los tipos archivo por archivo, sin mirar el resto del proyecto.
    // Estas tres opciones prohíben la sintaxis que ese borrado no puede resolver
    // (enum, namespace, parámetros con `private`, imports de tipos ambiguos).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // En ESM los imports llevan extensión. Como no se compila, se importa el .ts tal cual.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["back/**/*.ts"]
}
